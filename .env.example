# MongoDB Atlas (M0) connection string.
MONGODB_URI=
# Database name — defaults to "easyteslatrip" if unset.
MONGODB_DB=

# --- Used by later tickets, not yet wired into code ---

# Home Assistant, reached remotely via Nabu Casa.
HA_BASE_URL=
HA_LONG_LIVED_TOKEN=

# Mapbox (reverse geocoding + map rendering).
MAPBOX_TOKEN=

# NextAuth: session-signing secret and the single user's bcrypt password hash.
AUTH_SECRET=
AUTH_PASSWORD_HASH=

# Bearer secret checked on the HA-polling trigger endpoint (UptimeRobot).
POLL_TRIGGER_SECRET=
